# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Path to your trained model checkpoint
V2T_CHECKPOINT=outputs/checkpoints/best.ckpt

# Path to the BPE vocabulary file (auto-created by train.py)
V2T_VOCAB_PATH=cache/vocab.json

# Device: "auto" lets the engine pick GPU if available, else CPU
V2T_DEVICE=auto

# Number of ThreadPoolExecutor workers for beam search
V2T_WORKERS=2
