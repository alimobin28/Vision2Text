# Copy to .env and edit. Every setting is optional; the values below are the
# defaults from src/config.py. .env is gitignored — never commit it.
# Any setting can also be provided as a normal environment variable (V2T_ prefix).

# ---- dataset -----------------------------------------------------------------
# Download Flickr8k with:  python -m src.data.download
V2T_DATASET_NAME=flickr8k          # flickr8k | flickr30k
V2T_DATA_DIR=data                  # holds captions.txt and Images/ (kept OUT of src/)
# V2T_CAPTIONS_FILE=               # default per dataset: captions.txt | results.csv
# V2T_IMAGES_SUBDIR=               # default per dataset: Images | flickr30k_images
V2T_VAL_FRACTION=0.1
V2T_TEST_FRACTION=0.1
V2T_MAX_IMAGES=0                   # 0 = all; e.g. 200 for a quick smoke run

# ---- training ----------------------------------------------------------------
V2T_MAX_EPOCHS=30
V2T_BATCH_SIZE=32
V2T_NUM_WORKERS=4
V2T_LEARNING_RATE=1e-4
V2T_BACKBONE_LR_MULT=0.1           # pretrained CNN learns at lr * this
V2T_EARLY_STOPPING_PATIENCE=5      # 0 disables
V2T_SEED=42
V2T_OUTPUT_DIR=outputs             # checkpoints/, logs/, model.pt, metrics_*.json

# ---- serving -----------------------------------------------------------------
V2T_CHECKPOINT=outputs/model.pt    # written by train.py (weights + architecture + tokenizer)
V2T_DEVICE=auto                    # auto | cpu | cuda | mps
V2T_WORKERS=2                      # inference threads in the API process
