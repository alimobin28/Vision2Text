# ============================================================
# Data, caches, and large binary artifacts
# These are too big for git — store them outside the repo or
# use DVC / cloud storage.
#
# NOTE: "/data/" is anchored to the repo root on purpose. An unanchored
# "data/" also matched the source package src/data/, which silently kept
# dataset.py / vocab.py / preprocessing.py out of every commit.
# ============================================================
/data/
cache/
*.h5
*.hdf5
vocab.json

# ============================================================
# Model weights and checkpoints
# ============================================================
checkpoints/
outputs/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# ============================================================
# Docker
# ============================================================
# Keep docker-compose.yml and Dockerfile tracked.
# Ignore local override files and generated volumes.
docker-compose.override.yml
docker-compose.local.yml
.docker/

